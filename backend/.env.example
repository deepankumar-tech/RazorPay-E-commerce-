PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/commerce_ai?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_minimum_32_characters_long

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_secret
