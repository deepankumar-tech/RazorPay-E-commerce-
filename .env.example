# Root Environment Variables Template

# Backend Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commerce_ai?schema=public

# Security / JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min_32_chars

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Frontend Settings (Vite prefix)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
